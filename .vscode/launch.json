      "justMyCode": false
    },
    {
      // DPO 快速验证：20 步，约 15 秒。只看链路通不通。
      // 关键自检：第一步的 loss 必须约等于 ln2 = 0.6931
      // （policy 和 ref 权重相同 -> logits=0 -> -logsigmoid(0)=ln2）。
      // 偏离 0.693 说明 policy/ref 没有从同一份权重起步，或 mask 算错了。
      "name": "⑰ DPO-快速验证（20步，约15秒）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_dpo.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\dpo.jsonl",
        "--from_weight", "out_quick/pretrain_epoch1.pth",
        "--max_steps", "20",
        "--log_interval", "5",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // DPO 正式：500 步，实测 0.25 秒/步、显存 3962MB，约 2 分钟。
      // 必须先跑过 SFT 拿到 out/sft_epoch1.pth（用 pretrain 权重做 DPO 没有意义，
      // 基座对 chosen/rejected 本来就没有偏好）。
      // 关注指标：loss 应从 0.693 下降，acc（chosen 隐含奖励 > rejected 的比例）
      // 应从 50% 附近稳步上升。acc 长期不动说明 beta 或学习率不合适。
      "name": "⑱ DPO-正式（500步，约2分钟）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_dpo.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\dpo.jsonl",
        "--from_weight", "out/sft_epoch1.pth",
        "--max_steps", "500",
        "--save_interval", "250",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // SFT 早停版：切 2% 数据做验证集，每 500 步评一次，连续 2 次不改善就停。
      // 背景：⑫ 那版跑满 2500 步后，训练域 assistant ppl 从 292.6 降到 19.2，
      // 但域外留出集从 1015 涨到 1288 —— 后 1000 步在拟合噪声。
      // 这版会在拐头处停下，并把最好那份另存为 out/sft_best.pth。
      // 注意：验证集与训练集同分布，只能防「同分布过拟合」；
      // 想看过拟合导致的泛化退化，得用 _tmp/eval_sft_fmt.py 在域外数据上评。
      "name": "⑲ SFT-带早停（验证集2%，约10分钟）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_sft.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\sft_20k.jsonl",
        "--from_weight", "out_quick/pretrain_epoch1.pth",
        "--max_steps", "2500",
        "--val_ratio", "0.02",
        "--eval_interval", "500",
        "--patience", "2",
        "--save_interval", "500",
        "--out_dir", "out",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // DPO 修复版：NLL 正则治 likelihood displacement + 生成守卫防训崩。
      // 实测不加这两项时，lr 5e-6 跑 1000 步会把模型烧掉（生成只剩「人工智能是AI」，
      // 而 loss 全程稳在 0.69，从 loss 完全看不出来）。
      // 守卫每 200 步真采样一次，有效输出 < 8 token 就判定崩坏，
      // 存成 dpo_..._broken_stepN.pth 并主动停下（退出码 0，不是报错）。
      "name": "⑳ DPO-带NLL正则与守卫（lr1e-6，800步）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_dpo.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\dpo.jsonl",
        "--from_weight", "out/sft_epoch1.pth",
        "--learning_rate", "1e-6",
        "--nll_coef", "0.2",
        "--gen_guard_interval", "200",
        "--max_steps", "800",
        "--save_interval", "400",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // GRPO 快速验证：1 步 × 2 条采样，只确认链路能跑通（显存约 2GB）。
      // 关注：reward 有值、avg response len > 0、loss 不是 nan。
