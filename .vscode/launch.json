      // 前提：先跑过 ⑫，得到 out/sft_epoch1.pth；没跑过就把 --from_weight 换成 out_quick/pretrain_epoch1.pth
      "name": "⑬ LoRA-快速验证（20步，约1分钟）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_lora.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\sft_20k.jsonl",
        "--from_weight", "out/sft_epoch1.pth",
        "--out_dir", "out",
        "--lora_name", "lora_demo",
        "--lora_rank", "16",
        "--batch_size", "8",
        "--max_seq_len", "768",
        "--max_steps", "20",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // LoRA 正式：3 epoch = 7500 步，实测约 350 ms/步，约 45 分钟。
      // 只训 0.3932M 参数（0.611%），显存约 2.5GB。
      // 注意 LoRA 不比 SFT 快多少：反向仍要过全部 8 层，省的是显存和权重体积
      "name": "⑭ LoRA-正式（3 epoch，约45分钟）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_lora.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\sft_20k.jsonl",
        "--from_weight", "out/sft_epoch1.pth",
        "--out_dir", "out",
        "--lora_name", "lora_demo",
        "--lora_rank", "16",
        "--batch_size", "8",
        "--max_seq_len", "768",
        "--epochs", "3",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // PPO 快速验证：8 条样本、生成 64 token，约 10 秒，只看链路通不通。
      // 四个模型（actor/old/ref/critic）各占一份权重，显存峰值约 3.4GB。
      // 用 pretrain 权重只是为了跑通，生成的是胡话（正常现象）。
      "name": "⑮ PPO-快速验证（8条，约10秒）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_ppo.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\rlaif.jsonl",
        "--from_weight", "out_quick/pretrain_epoch1.pth",
        "--max_steps", "8",
        "--max_gen_len", "64",
        "--batch_size", "2",
        "--accumulation_steps", "2",
        "--log_interval", "1",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      // PPO 正式：200 条样本、生成 256 token，实测约 1.7 秒/条，
      // 加启动开销总计约 6 分钟（显存峰值约 3.4GB）。
      // 必须先跑过 SFT 拿到 out/sft_epoch1.pth，用 pretrain 权重做 RL 没有意义
      // （基座本身不会说话，奖励全是负的，学不到东西）。
      // 关注指标：reward 应缓慢上升、kl_ref 不应爆涨（> 2 说明跑飞了）、ratio 在 1 附近。
      "name": "⑯ PPO-正式（200条 gen256，约5分钟）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_ppo.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\rlaif.jsonl",
        "--from_weight", "out/sft_epoch1.pth",
        "--max_steps", "200",
        "--max_gen_len", "256",
        "--batch_size", "4",
        "--accumulation_steps", "4",
        "--save_interval", "100",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
