      // 实测 loss 5.25 / ppl 190 / 生成约 50 tok/s
      "name": "⑩ MoE-评估权重（out_moe/）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
