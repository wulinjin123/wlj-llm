      "name": "⑫ SFT-正式（1 epoch 2500步，约9分钟）",
      "type": "debugpy",
      "python": "D:\\Anaconda\\envs\\minimind\\python.exe",
      "request": "launch",
      "program": "${workspaceFolder}/trainer/train_sft.py",
      "args": [
        "--data_path", "D:\\Projects\\minimind\\dataset\\sft_20k.jsonl",
        "--from_weight", "out_quick/pretrain_epoch1.pth",
        "--batch_size", "8",
        "--max_seq_len", "768",
        "--save_interval", "500",
        "--no_swanlab"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
